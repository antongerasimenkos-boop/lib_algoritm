{
    "name": "questionnaire_templates",
    "version": "0.5.0",
    "private": true,
    "scripts": {
        "serve": "vue-cli-service serve",
        "build": "vue-cli-service build",
        "test:unit": "vue-cli-service test:unit",
        "lint": "vue-cli-service lint"
    },
    "dependencies": {
        "core-js": "^3.6.5",
        "less": "^3.13.1",
        "node-fetch": "^2.7.0",
        "vue": "^2.6.11",
        "vue-router": "^3.4.9",
        "vue2-perfect-scrollbar": "^1.5.56",
        "vuex": "^3.4.0",
        "webpack": "^5.105.4"
    },
    "devDependencies": {
        "@babel/core": "^7.12.10",
        "@vue/cli-plugin-babel": "^5.0.9",
        "@vue/cli-plugin-eslint": "^5.0.9",
        "@vue/cli-plugin-router": "^4.5.10",
        "@vue/cli-plugin-unit-mocha": "^5.0.9",
        "@vue/cli-plugin-vuex": "^4.5.10",
        "@vue/cli-service": "^5.0.9",
        "@vue/eslint-config-prettier": "^6.0.0",
        "@vue/test-utils": "^1.0.3",
        "babel-eslint": "^10.1.0",
        "babel-loader": "^8.2.2",
        "chai": "^4.1.2",
        "css-loader": "^7.1.4",
        "eslint": "^10.0.3",
        "eslint-plugin-prettier": "^3.1.3",
        "eslint-plugin-vue": "^6.2.2",
        "less-loader": "^7.3.0",
        "mini-css-extract-plugin": "^0.9.0",
        "prettier": "^1.19.1",
        "uikit": "^3.6.5",
        "vue-loader": "^15.11.1",
        "vue-template-compiler": "^2.6.11"
    },
    "eslintConfig": {
        "root": true,
        "env": {
            "node": true
        },
        "extends": [
            "plugin:vue/essential",
            "eslint:recommended",
            "@vue/prettier"
        ],
        "parserOptions": {
            "parser": "babel-eslint"
        },
        "rules": {
            "semi": "off",
            "comma-dangle": "off",
            "require-jsdoc": "off"
        },
        "overrides": [
            {
                "files": [
                    "**/__tests__/*.{j,t}s?(x)",
                    "**/tests/unit/**/*.spec.{j,t}s?(x)"
                ],
                "env": {
                    "mocha": true
                }
            }
        ]
    },
    "browserslist": [
        "> 1%",
        "last 2 versions",
        "not dead"
    ]
}
